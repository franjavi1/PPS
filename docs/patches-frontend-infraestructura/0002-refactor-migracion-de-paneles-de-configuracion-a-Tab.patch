+  // Declaramos el estado de control numérico para el wizard
+  const [paso, setPaso] = useState(1);
+  const [erroresLocales, setErroresLocales] = useState({});
+
+  // Reiniciamos el stepper al cerrar el modal
+  useEffect(() => {
+    if (!mostrarModal) {
+      setPaso(1);
+      setErroresLocales({});
+    }
+  }, [mostrarModal]);
+
+  if (!mostrarModal) return null;
+
+  const pasos = [
