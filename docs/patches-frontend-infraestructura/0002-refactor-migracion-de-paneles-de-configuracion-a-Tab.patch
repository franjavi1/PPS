+          <CampoTexto
+            label="Vigencia desde"
+            name="vigencia_dde"
+            type="date"
+            value={plan.vigencia_dde}
+            onChange={cambiarPlan}
+          />
+          <CampoTexto
+            label="Vigencia hasta"
+            name="vigencia_hta"
+            type="date"
+            value={plan.vigencia_hta}
