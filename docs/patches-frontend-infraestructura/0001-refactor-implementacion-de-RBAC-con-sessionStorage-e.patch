+      </div>
+      <h2 className="text-2xl font-extrabold text-slate-800">{titulo}</h2>
+    </div>
+  );
+}
+
+export function CampoTexto({
+  label,
+  name,
+  value,
+  onChange,
+  placeholder,
+  type = "text",
+  icono,
+}) {
+  return (
+    <div>
+      <label className="block text-sm font-bold text-slate-700 mb-2">
+        {label}
+      </label>
