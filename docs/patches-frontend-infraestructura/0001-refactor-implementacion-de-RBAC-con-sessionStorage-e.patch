+
+export default function TabComisiones({
+  comisiones,
+  asignaturas,
+  aulas,
+  onRefresh,
+}) {
+  const [mostrarModal, setMostrarModal] = useState(false);
+  const [form, setForm] = useState({
+    id: null,
+    nombre: "",
+    asignaturaId: "",
+    aulaId: "",
+    cupoMaximo: "",
