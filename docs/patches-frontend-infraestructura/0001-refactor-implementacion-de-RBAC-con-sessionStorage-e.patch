+        )}
+      </div>
+
+      <Acciones guardando={false} texto="Finalizar alta" onBack={onBack} onSubmit={onNext} />
+    </section>
+  );
+}
+
+export function StepResumen({ plan, asignaturasCargadas, correlativasCargadas, volverPlanes, cargarOtroPlan }) {
