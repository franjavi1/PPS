+                        <button
+                          onClick={() => eliminar(c.id)}
+                          className="text-red-600 hover:text-red-800 flex items-center gap-1 font-semibold text-sm"
+                        >
+                          <Trash2 size={16} />
+                          Eliminar
+                        </button>
+                      </div>
+                    </td>
