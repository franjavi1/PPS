+  }
+
+  if (!contacto) {
+    return;
+  }
+
+  const tipoContacto = obtenerTipoContacto(tiposContacto, tipoNombre);
+  if (!tipoContacto) {
+    throw new Error(`No existe el tipo de contacto ${tipoNombre} en la base.`);
+  }
