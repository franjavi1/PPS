+    if (!form.nombre.trim()) {
+      tempErrors.nombre = "El nombre de la sede es requerido.";
+    }
+    if (!form.direccion.trim()) {
+      tempErrors.direccion = "La dirección de la sede es requerida.";
+    }
+    setErrors(tempErrors);
